      "parameters": {
        "jsCode": "const inputItem = $input.item.json;\n\n// Check all possible paths where Vapi or n8n might place the arguments\nconst body = inputItem.body || inputItem;\nconst message = body.message || {};\nconst toolCall = message.toolCalls?.[0] || {};\nconst args = toolCall.function?.arguments || body.arguments || body;\n\nconst customerId = args.customer_id || \"CUS-UNKNOWN\";\nconst customerName = args.full_name || \"Valued Customer\";\nconst email = args.email || \"\";\nconst phone = args.phone || \"\";\nconst purpose = args.purpose || \"Consultation\";\nconst dateStr = args.date || new Date().toISOString().split('T')[0];\nconst rawTime = String(args.start_time || '08:00').trim();\n\nlet hour = parseInt(rawTime.split(':')[0], 10);\n\nif (isNaN(hour) || (hour < 8) || (hour > 15)) {\n  throw new Error(`Invalid time slot: ${rawTime}. Bookings are only allowed between 8:00 AM and 3:00 PM.`);\n}\n\nreturn [{\n  json: {\n    customer_id: customerId,\n    full_name: customerName,\n    email: email,\n    phone: phone,\n    purpose: purpose,\n    date: dateStr,\n    start_time: rawTime,\n    end_time: `${String(hour + 1).padStart(2, '0')}:00`,\n    appointment_id: `APT-${dateStr.replace(/-/g, '')}-${Math.floor(1000 + Math.random() * 9000)}`\n  }\n}];"
      },
