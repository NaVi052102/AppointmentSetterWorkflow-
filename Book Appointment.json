        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    body { font-family: 'Segoe UI', Arial, sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; color: #333333; }\n    .card { max-width: 560px; margin: 0 auto; background: #ffffff; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }\n    .header { background: #0077b6; color: #ffffff; padding: 24px; text-align: center; }\n    .header h2 { margin: 0; font-size: 22px; font-weight: 600; }\n    .content { padding: 28px 24px; }\n    .status-badge { display: inline-block; background-color: #fff3cd; color: #856404; font-size: 13px; font-weight: 700; padding: 6px 14px; border-radius: 20px; text-transform: uppercase; margin-bottom: 20px; }\n    .details-table { width: 100%; border-collapse: collapse; margin: 20px 0; background-color: #fafafa; border-radius: 8px; }\n    .details-table td { padding: 12px 16px; border-bottom: 1px solid #eeeeee; font-size: 14px; }\n    .details-table tr:last-child td { border-bottom: none; }\n    .label { font-weight: 600; color: #666666; width: 40%; }\n    .value { font-weight: 500; color: #111111; }\n    .footer { text-align: center; padding: 20px; font-size: 12px; color: #888888; border-top: 1px solid #eeeeee; }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"header\">\n      <h2>Purist Unsolved Skincare</h2>\n    </div>\n    <div class=\"content\">\n      <div class=\"status-badge\">⏳ Pending Admin Approval</div>\n      <p>Hi <b>{{ $('Parse Booking Details & Validate Time Slot').first().json.full_name }}</b>,</p>\n      <p>Thank you for booking with us! We have received your appointment request and our team is currently reviewing the schedule.</p>\n      \n      <table class=\"details-table\">\n        <tr>\n          <td class=\"label\">Appointment ID</td>\n          <td class=\"value\"><b>{{ $('Parse Booking Details & Validate Time Slot').first().json.appointment_id }}</b></td>\n        </tr>\n        <tr>\n          <td class=\"label\">Service / Purpose</td>\n          <td class=\"value\">{{ $('Parse Booking Details & Validate Time Slot').first().json.purpose }}</td>\n        </tr>\n        <tr>\n          <td class=\"label\">Requested Date</td>\n          <td class=\"value\">{{ $('Parse Booking Details & Validate Time Slot').first().json.date }}</td>\n        </tr>\n        <tr>\n          <td class=\"label\">Requested Time</td>\n          <td class=\"value\">{{ $('Parse Booking Details & Validate Time Slot').first().json.start_time }}</td>\n        </tr>\n      </table>\n\n      <p style=\"font-size: 13px; color: #555555; background: #eef7fc; padding: 12px; border-left: 4px solid #0077b6; border-radius: 4px;\">\n        💡 <b>Tip:</b> Keep your <b>Appointment ID</b> handy. You can use it anytime to check status, reschedule, or cancel your booking over the phone.\n      </p>\n    </div>\n    <div class=\"footer\">\n      Purist Unsolved Skincare Clinic &bull; Mandaue City, Cebu\n    </div>\n  </div>\n</body>\n</html>",
