      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst body = inputData.body || inputData || {};\nconst message = body.message || {};\nconst toolCall = message.toolCalls?.[0] || {};\n\n// Parse function arguments if Vapi sends them as a JSON string\nlet args = toolCall.function?.arguments || body || {};\nif (typeof args === 'string') {\n  try {\n    args = JSON.parse(args);\n  } catch (e) {\n    args = {};\n  }\n}\n\n// Check for phone across all common key variants\nconst rawPhone = String(\n  message.customer?.number || \n  args.Phone ||\n  args.phone || \n  args.phone_number || \n  body.Phone ||\n  body.phone || \n  body.phone_number || \n  \"\"\n);\n\nlet phone = rawPhone.replace(/\\D/g, '');\nif (phone.startsWith('639') && phone.length === 12) {\n  phone = '0' + phone.substring(2);\n} else if (phone.startsWith('9') && phone.length === 10) {\n  phone = '0' + phone;\n}\n\nconst cleanedPhone = phone.trim();\n\nreturn [{\n  json: {\n    fullName: args.full_name || body.full_name || args.fullName || body.fullName || \"\",\n    email: args.email || body.email || \"\",\n    Phone: cleanedPhone,\n    phone: cleanedPhone\n  }\n}];"
      },
