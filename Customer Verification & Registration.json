        "jsCode": "const parsed = $('Parse Incoming Customer Data').first().json;\n\nconst randomId = Math.floor(1000 + Math.random() * 9000);\nconst newCustomerId = `CUS-${randomId}`;\n\n// Generate correct local Philippine Time (UTC+8) timestamp\nconst now = new Date();\nconst phTime = new Date(now.getTime() + (8 * 60 * 60 * 1000));\nconst today = phTime.toISOString().replace('T', ' ').substring(0, 19);\n\nreturn [{\n  json: {\n    customer_id: newCustomerId,\n    full_name: parsed.fullName,\n    email: parsed.email,\n    phone: parsed.phone,\n    registered_date: today\n  }\n}];"
