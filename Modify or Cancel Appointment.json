      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst body = inputData.body || inputData || {};\nconst message = body.message || {};\nconst toolCall = message.toolCalls?.[0] || {};\n\n// Safely handle Vapi arguments whether passed as object or JSON string\nlet args = toolCall.function?.arguments || body || {};\nif (typeof args === 'string') {\n  try {\n    args = JSON.parse(args);\n  } catch (e) {\n    args = {};\n  }\n}\n\n// Standardize phone number\nconst rawPhone = message.customer?.number || args.phone || args.phone_number || body.phone || body.phone_number || \"\";\nlet phone = rawPhone.replace(/\\D/g, '');\nif (phone.startsWith('639') && phone.length === 12) {\n  phone = '0' + phone.substring(2);\n} else if (phone.startsWith('9') && phone.length === 10) {\n  phone = '0' + phone;\n}\n\n// Identify action type\nconst rawAction = (args.action || body.action || \"\").toLowerCase();\nconst action = rawAction.includes(\"cancel\") ? \"CANCEL\" : \"RESCHEDULE\";\n\nreturn [{\n  json: {\n    toolCallId: toolCall.id || \"call_mock_modify_123\",\n    action: action,\n    appointment_id: args.appointment_id || args.appointmentId || body.appointment_id || body.appointmentId || \"\",\n    customer_id: args.customer_id || args.customerId || body.customer_id || body.customerId || \"\",\n    phone: phone.trim(),\n    new_date: args.new_date || args.newDate || \"\",\n    new_time: args.new_time || args.newTime || \"\",\n    new_end_time: args.new_end_time || args.newEndTime || \"\",\n    new_purpose: args.new_purpose || args.purpose || body.new_purpose || body.purpose || \"\",\n    reason: args.reason || \"Customer requested change\"\n  }\n}];"
      },
